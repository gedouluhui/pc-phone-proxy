<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.luhui.phoneproxy"
    android:versionCode="13"
    android:versionName="4.0.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup=false: node credentials must not leave the phone through
         adb backup or cloud backup (review C11).
         Subscription imports now require HTTPS and a DNS-pinned validated
         connection, so the app no longer declares cleartext traffic. -->
    <application
        android:label="手机代理"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- stopWithTask=false：从多任务卡片划掉时不要把正在跑的隧道一起杀掉。
             foregroundServiceType=specialUse：Android 14+ 起 targetSdk>=34 必须声明，
             否则 startForeground() 直接抛异常；这里先声明好，升级 target 时不用再改。 -->
        <service
            android:name=".ProxyVpnService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>
    </application>
</manifest>